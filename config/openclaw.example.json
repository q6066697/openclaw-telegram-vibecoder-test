{
  "channels": {
    "telegram": {
      "enabled": true
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${secret:store:default:GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.4-nano"
      }
    },
    "entries": {
      "main": {
        "modelPolicy": {
          "allow": ["openai/gpt-5.4-nano"]
        }
      }
    }
  },
  "plugins": {
    "entries": {
      "openai": {
        "enabled": true
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:api-key": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  },
  "skills": {
    "entries": {
      "web-search": {
        "enabled": true,
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "BRAVE_API_KEY"
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": ["telegram:<OWNER_TELEGRAM_USER_ID>"]
  },
  "tools": {
    "codeMode": {
      "enabled": false
    }
  }
}
